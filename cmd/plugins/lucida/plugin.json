{
  "id": "lucida",
  "name": "Lucida",
  "version": "1.1.0",
  "author": "sonar",
  "description": "Downloads Amazon Music tracks through lucida.to. The Cloudflare check passes by itself in an invisible browser; a manual window is the fallback.",
  "kind": "downloader",
  "run": [
    "lucida"
  ],
  "contract": 1,
  "downloader": {
    "accepts": "amazon",
    "parallel": 1,
    "guard": {
      "limit": 50,
      "waits": [
        15,
        30,
        60,
        120
      ],
      "wait": 30
    }
  },
  "settings": [
    {
      "key": "check",
      "type": "button",
      "action": "check",
      "label": {
        "en": "Pass check",
        "ru": "Пройти проверку"
      }
    }
  ]
}
